# ==============================================
# HOBERG EDU - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================

# Next.js Application Public URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Public Keys (Safe for browser / client components)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Service Role Key (CRITICAL: SERVER-ONLY, NEVER EXPOSE TO CLIENT)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Paystack API Keys (₦5,000/month recurring premium plan)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=your-paystack-public-key
PAYSTACK_SECRET_KEY=your-paystack-secret-key
PAYSTACK_WEBHOOK_SECRET=your-paystack-webhook-secret
PAYSTACK_PREMIUM_PLAN_CODE=PLN_hoberg_premium_monthly