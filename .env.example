# ==============================================
# HOBERG EDU - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================

# Next.js Application Public URL
NEXT_PUBLIC_APP_URL=https://edu.hoberg.com.ng

# Supabase Public Keys (Safe for browser / client components)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Service Role Key (CRITICAL: SERVER-ONLY, NEVER EXPOSE TO CLIENT)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Note: Paystack API Keys are temporarily removed.
# Add them later in Vercel Dashboard under Environment Variables.
